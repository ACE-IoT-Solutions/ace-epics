@prefix epics: <https://w3id.org/ace-epics#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

epics:DocumentShape a sh:NodeShape ;
    sh:targetClass epics:Document ;
    sh:property [ sh:path epics:headerCode ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 5 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path epics:vendorName ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path epics:productName ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path epics:productModelNumber ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path epics:productDescription ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path epics:objectOrder ; sh:nodeKind sh:BlankNodeOrIRI ; sh:minCount 1 ; sh:maxCount 1 ] .

epics:ObjectShape a sh:NodeShape ;
    sh:targetClass epics:Object ;
    sh:property [ sh:path epics:instance ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 4194303 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path epics:objectName ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path epics:objectType ; sh:minCount 1 ; sh:maxCount 1 ; sh:or ( [ sh:datatype xsd:string ] [ sh:datatype xsd:integer ] ) ] ;
    sh:property [ sh:path epics:propertyOrder ; sh:nodeKind sh:BlankNodeOrIRI ; sh:minCount 1 ; sh:maxCount 1 ] .

epics:PropertyShape a sh:NodeShape ;
    sh:targetClass epics:Property ;
    sh:property [ sh:path epics:propertyName ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path epics:access ; sh:in ( epics:ReadOnly epics:Writable epics:ConditionallyWritable ) ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path epics:notReadable ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
    sh:property [ sh:path epics:value ; sh:minCount 1 ; sh:maxCount 1 ] .

epics:LexicalValueShape a sh:NodeShape ;
    sh:targetSubjectsOf epics:lexical ;
    sh:property [ sh:path epics:lexical ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] .
