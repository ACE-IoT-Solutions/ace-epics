@prefix ace-epics: <https://w3id.org/ace-epics#> .
@prefix bacnet: <http://data.ashrae.org/bacnet/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/ace-epics> a owl:Ontology ;
    rdfs:label "BACnet EPICS interchange vocabulary" ;
    rdfs:comment "EPICS-specific extensions to the BACpypes3 0.0.110 BACnet RDF vocabulary. Standard object identities, properties, and values use bacnet:; ace-epics: retains declarations, syntax, restrictions, order, and unavailable values. Extension terms are not ASHRAE standard terms and may migrate when upstream defines equivalent concepts." ;
    owl:versionInfo "ace-epics/1" .

ace-epics:Document a owl:Class ; rdfs:label "EPICS document" .
ace-epics:Object a owl:Class ; rdfs:label "EPICS object declaration metadata" ; rdfs:comment "Marks a test database declaration with EPICS property order and metadata. Its BACnet headers use the upstream vocabulary. A separate bacnet:Device endpoint contains these object declarations." ; owl:disjointWith ace-epics:Property .
ace-epics:ObjectIdentifier a owl:Class ; rdfs:label "Object identifier" .
ace-epics:Property a owl:Class ; rdfs:label "Property declaration" .
ace-epics:ServiceSupport a owl:Class ; rdfs:label "Application service support" .
ace-epics:ObjectTypeSupport a owl:Class ; rdfs:label "Object type support" .
ace-epics:DataLink a owl:Class ; rdfs:label "Data link option" .
ace-epics:Iso88023DataLink a owl:Class ; rdfs:subClassOf ace-epics:DataLink .
ace-epics:ArcnetDataLink a owl:Class ; rdfs:subClassOf ace-epics:DataLink .
ace-epics:MsTpDataLink a owl:Class ; rdfs:subClassOf ace-epics:DataLink .
ace-epics:PointToPointDataLink a owl:Class ; rdfs:subClassOf ace-epics:DataLink .
ace-epics:BacnetIpDataLink a owl:Class ; rdfs:subClassOf ace-epics:DataLink .
ace-epics:BacnetIpv6DataLink a owl:Class ; rdfs:subClassOf ace-epics:DataLink .
ace-epics:BacnetScDataLink a owl:Class ; rdfs:subClassOf ace-epics:DataLink .
ace-epics:ZigbeeDataLink a owl:Class ; rdfs:subClassOf ace-epics:DataLink .
ace-epics:OtherDataLink a owl:Class ; rdfs:subClassOf ace-epics:DataLink .
ace-epics:SpecialFunctionality a owl:Class ; rdfs:label "Special functionality" .
ace-epics:RestrictionSet a owl:Class ; rdfs:label "Datatype or property restrictions" .
ace-epics:DefaultRestrictions a owl:Class ; rdfs:label "Default restrictions by datatype" .
ace-epics:FailTime a owl:Class ; rdfs:label "Timer and seconds" .
ace-epics:FailTimes a owl:Class ; rdfs:label "Ordered timer declaration fields" .
ace-epics:Dictionary a owl:Class ; rdfs:label "Extension dictionary" .
ace-epics:Record a owl:Class ; rdfs:label "Structured record" .
ace-epics:Value a owl:Class ; rdfs:label "Syntactic EPICS value" .
ace-epics:NullValue a owl:Class ; rdfs:subClassOf ace-epics:Value .
ace-epics:BooleanValue a owl:Class ; rdfs:subClassOf ace-epics:Value ; owl:disjointWith ace-epics:IntegerValue .
ace-epics:IntegerValue a owl:Class ; rdfs:subClassOf ace-epics:Value .
ace-epics:RealValue a owl:Class ; rdfs:subClassOf ace-epics:Value .
ace-epics:OctetStringValue a owl:Class ; rdfs:subClassOf ace-epics:Value .
ace-epics:CharacterStringValue a owl:Class ; rdfs:subClassOf ace-epics:Value .
ace-epics:EnumeratedValue a owl:Class ; rdfs:subClassOf ace-epics:Value .
ace-epics:DateValue a owl:Class ; rdfs:subClassOf ace-epics:Value .
ace-epics:TimeValue a owl:Class ; rdfs:subClassOf ace-epics:Value .
ace-epics:DateRangeValue a owl:Class ; rdfs:subClassOf ace-epics:Value .
ace-epics:ObjectIdentifierValue a owl:Class ; rdfs:subClassOf ace-epics:Value .
ace-epics:ContextTaggedValue a owl:Class ; rdfs:subClassOf ace-epics:Value .
ace-epics:GroupValue a owl:Class ; rdfs:subClassOf ace-epics:Value .
ace-epics:EmptyElement a owl:Class ; rdfs:subClassOf ace-epics:Value .
ace-epics:UnspecifiedValue a owl:Class ; rdfs:subClassOf ace-epics:Value .
ace-epics:WildcardValue a owl:Class ; rdfs:subClassOf ace-epics:Value .
ace-epics:emptyElement a ace-epics:EmptyElement ; ace-epics:lexical "" .
ace-epics:unspecifiedValue a ace-epics:UnspecifiedValue ; ace-epics:lexical "?" .
ace-epics:ReadOnly a owl:NamedIndividual ; rdfs:label "Read only (R)" .
ace-epics:Writable a owl:NamedIndividual ; rdfs:label "Writable (W)" .
ace-epics:ConditionallyWritable a owl:NamedIndividual ; rdfs:label "Conditionally writable (C)" .
ace-epics:Null a owl:NamedIndividual ; rdfs:label "Absent scalar in an extension dictionary" .

ace-epics:headerCode a owl:DatatypeProperty ; rdfs:range xsd:integer .
ace-epics:vendorName a owl:DatatypeProperty ; rdfs:range xsd:string .
ace-epics:productName a owl:DatatypeProperty ; rdfs:range xsd:string .
ace-epics:productModelNumber a owl:DatatypeProperty ; rdfs:range xsd:string .
ace-epics:productDescription a owl:DatatypeProperty ; rdfs:range xsd:string .
ace-epics:bibb a rdf:Property ; rdfs:comment "BIBB name literal; bibbOrder preserves declarations." .
ace-epics:service a owl:ObjectProperty ; rdfs:range ace-epics:ServiceSupport .
ace-epics:serviceName a owl:DatatypeProperty ; rdfs:range xsd:string .
ace-epics:initiate a owl:DatatypeProperty ; rdfs:range xsd:boolean .
ace-epics:execute a owl:DatatypeProperty ; rdfs:range xsd:boolean .
ace-epics:objectTypeSupport a owl:ObjectProperty ; rdfs:range ace-epics:ObjectTypeSupport .
ace-epics:dataLink a owl:ObjectProperty ; rdfs:range ace-epics:DataLink .
ace-epics:baudRate a owl:DatatypeProperty ; rdfs:range xsd:integer .
ace-epics:characterSet a owl:DatatypeProperty .
ace-epics:special a owl:ObjectProperty ; rdfs:range ace-epics:SpecialFunctionality .
ace-epics:defaultRestriction a owl:ObjectProperty ; rdfs:range ace-epics:DefaultRestrictions .
ace-epics:datatypeKey a owl:DatatypeProperty ; rdfs:range xsd:string .
ace-epics:failTime a owl:ObjectProperty ; rdfs:range ace-epics:FailTime .
ace-epics:timerName a owl:DatatypeProperty ; rdfs:range xsd:string .
ace-epics:seconds a owl:DatatypeProperty ; rdfs:range xsd:double .
ace-epics:object a owl:ObjectProperty ; rdfs:range ace-epics:Object .
ace-epics:objectType a rdf:Property .
ace-epics:instance a owl:DatatypeProperty ; rdfs:range xsd:integer .
ace-epics:objectName a owl:DatatypeProperty ; rdfs:range xsd:string .
ace-epics:objectIdentifier a owl:ObjectProperty ; rdfs:range ace-epics:ObjectIdentifier .
ace-epics:property a owl:ObjectProperty ; rdfs:range ace-epics:Property .
ace-epics:propertyName a owl:DatatypeProperty ; rdfs:range xsd:string .
ace-epics:access a owl:ObjectProperty .
ace-epics:notReadable a owl:DatatypeProperty ; rdfs:range xsd:boolean .
ace-epics:comment a owl:DatatypeProperty ; rdfs:range xsd:string .
ace-epics:restriction a owl:ObjectProperty ; rdfs:range ace-epics:RestrictionSet .
ace-epics:value a owl:ObjectProperty ; rdfs:range ace-epics:Value .
ace-epics:lexical a owl:DatatypeProperty ; rdfs:range xsd:string .
ace-epics:typedValue a rdf:Property ; rdfs:comment "Derived typed convenience literal; lexical is authoritative." .
ace-epics:delimiter a owl:DatatypeProperty ; rdfs:range xsd:string .
ace-epics:tag a owl:DatatypeProperty ; rdfs:range xsd:integer .
ace-epics:elements a owl:ObjectProperty ; rdfs:range rdf:List .
ace-epics:objectOrder a owl:ObjectProperty ; rdfs:range rdf:List .
ace-epics:propertyOrder a owl:ObjectProperty ; rdfs:range rdf:List .
ace-epics:serviceOrder a owl:ObjectProperty ; rdfs:range rdf:List .
ace-epics:bibbOrder a owl:ObjectProperty ; rdfs:range rdf:List .
ace-epics:objectTypeSupportOrder a owl:ObjectProperty ; rdfs:range rdf:List .
ace-epics:dataLinkOrder a owl:ObjectProperty ; rdfs:range rdf:List .
ace-epics:characterSetOrder a owl:ObjectProperty ; rdfs:range rdf:List .
ace-epics:baudRateOrder a owl:ObjectProperty ; rdfs:range rdf:List .
ace-epics:entryOrder a owl:ObjectProperty ; rdfs:range rdf:List .

# Structured-model fields supplement the core vocabulary.
ace-epics:acknowledgementFailTime a rdf:Property ; rdfs:label "acknowledgementFailTime" .
ace-epics:activateChangesFailTime a rdf:Property ; rdfs:label "activateChangesFailTime" .
ace-epics:allowedValues a rdf:Property ; rdfs:label "allowedValues" .
ace-epics:allowedValuesOrder a rdf:Property ; rdfs:label "allowedValuesOrder" .
ace-epics:auditNotificationForwarderFailTime a rdf:Property ; rdfs:label "auditNotificationForwarderFailTime" .
ace-epics:autoNegotiationFailTime a rdf:Property ; rdfs:label "autoNegotiationFailTime" .
ace-epics:autobaud a rdf:Property ; rdfs:label "autobaud" .
ace-epics:autobaudOrder a rdf:Property ; rdfs:label "autobaudOrder" .
ace-epics:bacnetIpBbmd a rdf:Property ; rdfs:label "bacnetIpBbmd" .
ace-epics:bacnetIpv6Bbmd a rdf:Property ; rdfs:label "bacnetIpv6Bbmd" .
ace-epics:bacnetScDirectConnect a rdf:Property ; rdfs:label "bacnetScDirectConnect" .
ace-epics:bacnetScHub a rdf:Property ; rdfs:label "bacnetScHub" .
ace-epics:canonical a rdf:Property ; rdfs:label "canonical" .
ace-epics:channelWriteFailTime a rdf:Property ; rdfs:label "channelWriteFailTime" .
ace-epics:characterString a rdf:Property ; rdfs:label "characterString" .
ace-epics:charsetCode a rdf:Property ; rdfs:label "charsetCode" .
ace-epics:createable a rdf:Property ; rdfs:label "createable" .
ace-epics:date a rdf:Property ; rdfs:label "date" .
ace-epics:day a rdf:Property ; rdfs:label "day" .
ace-epics:deleteable a rdf:Property ; rdfs:label "deleteable" .
ace-epics:double a rdf:Property ; rdfs:label "double" .
ace-epics:elementsOrder a rdf:Property ; rdfs:label "elementsOrder" .
ace-epics:encoding a rdf:Property ; rdfs:label "encoding" .
ace-epics:end a rdf:Property ; rdfs:label "end" .
ace-epics:externalCommandFailTime a rdf:Property ; rdfs:label "externalCommandFailTime" .
ace-epics:extra a rdf:Property ; rdfs:label "extra" .
ace-epics:failTimes a rdf:Property ; rdfs:label "failTimes" .
ace-epics:foreignDeviceRegistrationFailTime a rdf:Property ; rdfs:label "foreignDeviceRegistrationFailTime" .
ace-epics:hour a rdf:Property ; rdfs:label "hour" .
ace-epics:hundredth a rdf:Property ; rdfs:label "hundredth" .
ace-epics:internalProcessingFailTime a rdf:Property ; rdfs:label "internalProcessingFailTime" .
ace-epics:item a rdf:Property ; rdfs:label "item" .
ace-epics:key a rdf:Property ; rdfs:label "key" .
ace-epics:kind a rdf:Property ; rdfs:label "kind" .
ace-epics:list a rdf:Property ; rdfs:label "list" .
ace-epics:maxApduSize a rdf:Property ; rdfs:label "maxApduSize" .
ace-epics:maximum a rdf:Property ; rdfs:label "maximum" .
ace-epics:maximumLengthArray a rdf:Property ; rdfs:label "maximumLengthArray" .
ace-epics:maximumLengthList a rdf:Property ; rdfs:label "maximumLengthList" .
ace-epics:maximumLengthString a rdf:Property ; rdfs:label "maximumLengthString" .
ace-epics:media a rdf:Property ; rdfs:label "media" .
ace-epics:medium a rdf:Property ; rdfs:label "medium" .
ace-epics:minimum a rdf:Property ; rdfs:label "minimum" .
ace-epics:minimumOnOffTime a rdf:Property ; rdfs:label "minimumOnOffTime" .
ace-epics:minute a rdf:Property ; rdfs:label "minute" .
ace-epics:mode a rdf:Property ; rdfs:label "mode" .
ace-epics:month a rdf:Property ; rdfs:label "month" .
ace-epics:name a rdf:Property ; rdfs:label "name" .
ace-epics:notificationFailTime a rdf:Property ; rdfs:label "notificationFailTime" .
ace-epics:octetString a rdf:Property ; rdfs:label "octetString" .
ace-epics:oddLength a rdf:Property ; rdfs:label "oddLength" .
ace-epics:parenthesised a rdf:Property ; rdfs:label "parenthesised" .
