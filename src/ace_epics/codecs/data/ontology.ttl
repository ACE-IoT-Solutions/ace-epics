ace-epics:programObjectStateChangeFailTime a rdf:Property ; rdfs:label "programObjectStateChangeFailTime" .
ace-epics:proprietaryNumber a rdf:Property ; rdfs:label "proprietaryNumber" .
ace-epics:quote a rdf:Property ; rdfs:label "quote" .
