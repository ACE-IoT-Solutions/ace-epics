ace-epics:headerMetadata a rdf:Property ; rdfs:label "Object header property metadata" ; rdfs:range ace-epics:Dictionary .

ace-epics:describesDevice a owl:ObjectProperty ;
    rdfs:label "Device described by this EPICS document" ;
    rdfs:comment "Project provenance link from an EPICS document to the BACnet Device endpoint entity. Object declarations are contained by that endpoint using bacnet:contains." ;
    rdfs:domain ace-epics:Document ; rdfs:range bacnet:Device .

ace-epics:canonicalObjectType a rdf:Property ;
    rdfs:label "Canonical object type name from EPICS" ;
    rdfs:comment "Retains the canonical EPICS name when the released BACpypes3 spelling differs, a newer standard object type is represented numerically, or an unresolved name requires an extension value. This is declaration provenance, not a shadow BACnet enumeration definition." ;
    rdfs:domain ace-epics:Object ; rdfs:range xsd:string .
